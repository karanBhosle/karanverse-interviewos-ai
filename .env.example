# Application
APP_ENV=development
APP_NAME=InterviewOS AI
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://interviewos:interviewos@localhost:5432/interviewos
DATABASE_SYNC_URL=postgresql://interviewos:interviewos@localhost:5432/interviewos

# Redis / workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth — local mode skips sign-in. Set AUTH_REQUIRED=true to turn login back on.
AUTHENTICATION_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REQUIRED=false

# Generic OpenAI-compatible LLM API — backend only. Never expose this key to the browser.
# Works with OpenAI, Azure OpenAI, Groq, OpenRouter, Ollama, vLLM, or any /chat/completions endpoint.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=2048
LLM_HTTP_REFERER=
LLM_APP_NAME=InterviewOS AI
SESSION_MAX_LLM_CALLS=20
SESSION_MAX_TOKENS=80000

# Retrieval
EMBEDDING_MODEL=hashing-fallback
VECTOR_STORE_PATH=./data/vector_store
USE_FAISS=false

# Uploads and retention
UPLOAD_LIMIT_MB=8
UPLOAD_DIR=./uploads
MEDIA_RETENTION_DAYS=14
MEDIA_STORAGE_ENABLED=false

# Vision
VISUAL_ANALYSIS_ENABLED=true
VISUAL_FRAME_SAMPLE_HZ=2
VISUAL_MAX_WIDTH=640

# HTTP
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=InterviewOS AI
